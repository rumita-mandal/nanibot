# ==========================
# NaniBot Environment Config
# ==========================
# Copy this file to .env and fill in your values.

# --- Database ---
POSTGRES_USER=nanibot
POSTGRES_PASSWORD=nanibot_secret_change_me
POSTGRES_DB=nanibot_db
DATABASE_URL=postgresql+asyncpg://nanibot:nanibot_secret_change_me@localhost:5432/nanibot_db

# --- Google Gemini API (FREE) ---
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- JWT Auth ---
SECRET_KEY=change_this_to_a_random_secret_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- App Config ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
ENVIRONMENT=development

# --- Admin ---
ADMIN_EMAIL=admin@nanibot.com
ADMIN_PASSWORD=admin_password_change_me

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Storage (local for MVP) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=nanibot_wisdom
